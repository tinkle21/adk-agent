# --- LLM (only needed for the conversational ADK agent / --summarize) ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-gemini-api-key
# ADK_MODEL=gemini-2.5-flash

# --- Fetching ---
# realestate.com.au and property.com.au block plain HTTP clients (HTTP 429).
# Point this at a scraping / unblocker API. "{url}" is replaced with the
# URL-encoded target. Examples:
#   https://api.scraperapi.com/?api_key=KEY&render=true&country_code=au&url={url}
#   https://api.zenrows.com/v1/?apikey=KEY&js_render=true&premium_proxy=true&url={url}
# FETCH_URL_TEMPLATE=
